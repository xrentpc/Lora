import time, requests
resp = requests.get('http://localhost:8188/object_info', timeout=10)
info = resp.json()
assert 'UltralyticsDetectorProvider' in info and 'SegsDetailer' in info
print('✅ Verified nodes present in ComfyUI: UltralyticsDetectorProvider, SegsDetailer')# Generate face-only workflow
import json, pathlib
wf = {
  "1": {"class_type": "LoadImage", "inputs": {"image": "frame_00001.png", "choose file to upload": "image"}},
  "2": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "v1-5-pruned.ckpt"}},
  "3": {"class_type": "LoraLoader", "inputs": {"model": ["2", 0], "clip": ["2", 1], "lora_name": "trained_lora.pth", "strength_model": 0.04, "strength_clip": 0.04}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "hyperrealistic face, natural skin", "clip": ["3", 1]}},
  "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "blurry, low quality, distorted", "clip": ["3", 1]}},
  "6": {"class_type": "VAEEncode", "inputs": {"pixels": ["1", 0], "vae": ["2", 2]}},
  "7": {"class_type": "UltralyticsDetectorProvider", "inputs": {"image": ["1", 0], "model_name": "bbox/face_yolov8n.pt", "confidence": 0.55}},
  "8": {"class_type": "SegsDetailer", "inputs": {"image": ["1", 0], "segs": ["7", 0], "model": ["3", 0], "positive": ["4", 0], "negative": ["5", 0], "vae": ["2", 2], "seed": 12345, "steps": 18, "cfg": 6.8, "sampler_name": "euler", "scheduler": "normal", "denoise": 0.01, "feather": 5, "dilation": 0}},
  "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "face_only"}}
}
path = pathlib.Path('/content/ComfyUI') / 'face_only_workflow.json'
with open(path, 'w') as f:
    json.dump(wf, f, indent=2)
print('✅ Workflow saved to', str(path))# Verify required nodes are available via API
import time, requests

time.sleep(5)
resp = requests.get('http://localhost:8188/object_info', timeout=10)
resp.raise_for_status()
info = resp.json()

required = ["UltralyticsDetectorProvider", "SegsDetailer"]
missing = [n for n in required if n not in info]

if missing:
    raise RuntimeError(f"Missing required nodes: {missing}. Ensure ComfyUI-Impact-Pack is installed and restart.")
print('✅ Required nodes are available:', required)# Start/Restart ComfyUI
import subprocess, time, requests
subprocess.run(["pkill", "-f", "main.py"], capture_output=True)

time.sleep(3)
process = subprocess.Popen([
    "python", "main.py", "--listen", "0.0.0.0", "--port", "8188"
], cwd="/content/ComfyUI")

time.sleep(15)
try:
    r = requests.get("http://localhost:8188", timeout=5)
    print('✅ ComfyUI running' if r.status_code==200 else '⚠️ ComfyUI responded non-200')
except Exception as e:
    print('❌ ComfyUI not reachable:', e)# Prepare directories and LoRA (optional)
import os, shutil, pathlib

base = pathlib.Path('/content/ComfyUI')
(base / 'models' / 'loras').mkdir(parents=True, exist_ok=True)
(base / 'input_videos' / 'frames').mkdir(parents=True, exist_ok=True)
(base / 'output_videos').mkdir(parents=True, exist_ok=True)

# Optionally copy LoRA from Drive
try:
    from google.colab import drive
    drive.mount('/content/drive')
    lora_src = pathlib.Path('/content/drive/MyDrive/comfyui_files/trained_lora.pth')
    lora_dst = base / 'models' / 'loras' / 'trained_lora.pth'
    if lora_src.exists():
        shutil.copy(lora_src, lora_dst)
        print('✅ LoRA placed as .pth')
    else:
        print('ℹ️ LoRA not found in Drive; you can upload trained_lora.pth manually')
except Exception as e:
    print('ℹ️ Drive not mounted; skip:', e)# Install required custom nodes and deps
